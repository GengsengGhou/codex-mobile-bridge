[Unit]
Description=Codex mobile hub owned backup and log maintenance

[Service]
Type=oneshot
ExecStart=/opt/codex-mobile-hub/runtime/bin/node /opt/codex-mobile-hub/app/deploy/maintenance.mjs
ExecStart=/usr/sbin/logrotate --state /var/lib/codex-mobile-hub/logrotate.status /etc/logrotate.d/codex-mobile-hub
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/codex-mobile-hub /etc/caddy /var/log/codex-mobile-hub /var/lib/codex-mobile-hub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

