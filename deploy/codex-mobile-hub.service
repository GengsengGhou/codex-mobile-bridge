[Unit]
Description=Codex mobile device hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexhub
Group=codexhub
WorkingDirectory=/opt/codex-mobile-hub/app
EnvironmentFile=/etc/codex-mobile-hub.env
ExecStart=/opt/codex-mobile-hub/runtime/bin/node hub/server.mjs
Restart=on-failure
RestartSec=5
MemoryHigh=192M
MemoryMax=256M
CPUQuota=100%
TasksMax=64
LimitNOFILE=512
Environment=NODE_OPTIONS=--max-old-space-size=128
LogsDirectory=codex-mobile-hub
LogsDirectoryMode=0700
StandardOutput=append:/var/log/codex-mobile-hub/service.log
StandardError=append:/var/log/codex-mobile-hub/service.log
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-mobile-hub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
